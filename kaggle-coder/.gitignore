# kaggle-coder: nothing secret, no tunnel addresses, no model files, no run output in git.

# Keys and credentials
.env
.env.*
!env.example
*.key
*.pem
api-keys.txt
*key*.txt
*token*.txt
*secret*.txt
kaggle.json
access_token
.kaggle/

# Aider files that could hold a key, an address or chat history
.aider*

# Notes someone might make about today's address or key
*tunnel*.txt
*address*.txt
notes-*.txt

# Notebook output, logs, downloads
*.log
*.part
*.gguf
*.vsix
*.ipynb
.ipynb_checkpoints/
output/
downloads/
